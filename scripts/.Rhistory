library(tidyverse)
library(cluster)
library(factoextra)
# Load data
members <- read.csv("members-1.csv")
# Keep only diagnosis columns + TA2 (result period total cost)
diag_cols <- grep("^Diag_", names(members), value = TRUE)
# Remove DD0046 (diabetes – all patients have it)
diag_cols <- diag_cols[diag_cols != "Diag_DD0046"]
# Subset to diagnosis columns + cost
data_full <- members[, c(diag_cols, "TA2")]
# --- Filter: keep members with at least 3 diagnoses ---
# (Increase threshold if clustering is too slow on your machine)
threshold <- 3
diag_only <- data_full[, diag_cols]
diag_counts <- rowSums(diag_only)
data_filtered <- data_full[diag_counts >= threshold, ]
cat("Threshold used:", threshold, "\n")
cat("Members retained:", nrow(data_filtered), "\n")
# Separate diagnosis matrix and cost vector
Train <- data_filtered[, diag_cols]
cost  <- data_filtered$TA2
cat("Computing Jaccard distance matrix (this may take a minute)...\n")
dist_jaccard <- daisy(Train, metric = "gower", type = list(asymm = 1:ncol(Train)))
# ---- Single Linkage, 15 clusters ----
hc_single <- hclust(dist_jaccard, method = "single")
memb_single <- cutree(hc_single, k = 15)
cat("\n--- Single Linkage: cluster sizes ---\n")
print(table(memb_single))
# ---- Complete Linkage, 15 clusters ----
hc_complete <- hclust(dist_jaccard, method = "complete")
memb_complete <- cutree(hc_complete, k = 15)
cat("\n--- Complete Linkage: cluster sizes ---\n")
print(table(memb_complete))
cluster_centers <- aggregate(Train, list(cluster = memb_complete), mean)
cat("\n--- Cluster Centers (fraction of members with each diagnosis) ---\n")
print(cluster_centers)
# Export cluster centers to CSV for easy visualization in Excel
write.csv(cluster_centers, "cluster_centers.csv", row.names = FALSE)
cat("Saved cluster_centers.csv\n")
# ---- Relative increase/decrease vs. overall prevalence ----
overall_prevalence <- colMeans(Train)
# For each cluster: (cluster_mean - overall_mean) / overall_mean
rel_change <- sweep(
as.matrix(cluster_centers[, -1]),   # remove cluster column
2,
overall_prevalence,
FUN = "-"
)
rel_change <- sweep(rel_change, 2, overall_prevalence, FUN = "/")
rel_change_df <- data.frame(cluster = cluster_centers$cluster, rel_change)
write.csv(rel_change_df, "relative_change.csv", row.names = FALSE)
cat("Saved relative_change.csv\n")
# ---- High-cost prevalence per cluster ----
high_cost_flag <- as.integer(cost > 20000)
cost_df <- data.frame(
cluster   = memb_complete,
high_cost = high_cost_flag
)
cost_summary <- cost_df %>%
group_by(cluster) %>%
summarise(
n_members   = n(),
n_high_cost = sum(high_cost),
pct_high_cost = mean(high_cost)
) %>%
arrange(desc(pct_high_cost))
cat("\n--- High-Cost Prevalence by Cluster (complete linkage) ---\n")
print(cost_summary)
write.csv(cost_summary, "high_cost_by_cluster.csv", row.names = FALSE)
cat("Saved high_cost_by_cluster.csv\n")
cat("\nHighest density cluster:", cost_summary$cluster[1],
"| P(high cost) =", round(cost_summary$pct_high_cost[1], 3), "\n")
cat("Lowest density cluster :", cost_summary$cluster[nrow(cost_summary)],
"| P(high cost) =", round(cost_summary$pct_high_cost[nrow(cost_summary)], 3), "\n")
# Convert to numeric matrix
Train_mat <- as.matrix(Train)
# ---- Elbow Chart to select k ----
set.seed(42)
wss <- sapply(1:20, function(k) {
kmeans(Train_mat, centers = k, nstart = 5, iter.max = 50)$tot.withinss
})
elbow_df <- data.frame(k = 1:20, WSS = wss)
ggplot(elbow_df, aes(x = k, y = WSS)) +
geom_line() + geom_point() +
scale_x_continuous(breaks = 1:20) +
labs(title = "Elbow Chart – K-Means",
x = "Number of Clusters (k)",
y = "Total Within-Cluster SS") +
theme_minimal()
ggsave("elbow_chart.png", width = 8, height = 5)
cat("Saved elbow_chart.png\n")
# ---- Run K-Means with chosen k (adjust based on elbow chart) ----
k_chosen <- 10   # <-- update after inspecting elbow chart
set.seed(42)
km <- kmeans(Train_mat, centers = k_chosen, nstart = 25, iter.max = 100)
cat("\n--- K-Means cluster sizes (k =", k_chosen, ") ---\n")
print(table(km$cluster))
# Cluster centers
km_centers <- data.frame(cluster = 1:k_chosen, km$centers)
write.csv(km_centers, "kmeans_centers.csv", row.names = FALSE)
cat("Saved kmeans_centers.csv\n")
# High-cost prevalence
km_cost_df <- data.frame(cluster = km$cluster, high_cost = high_cost_flag)
km_cost_summary <- km_cost_df %>%
group_by(cluster) %>%
summarise(
n_members     = n(),
n_high_cost   = sum(high_cost),
pct_high_cost = mean(high_cost)
) %>%
arrange(desc(pct_high_cost))
cat("\n--- K-Means: High-Cost Prevalence by Cluster ---\n")
print(km_cost_summary)
write.csv(km_cost_summary, "kmeans_high_cost.csv", row.names = FALSE)
cat("Saved kmeans_high_cost.csv\n")
# Relative change vs. overall prevalence for k-means
km_rel_change <- sweep(
as.matrix(km_centers[, -1]),
2,
overall_prevalence,
FUN = "-"
)
km_rel_change <- sweep(km_rel_change, 2, overall_prevalence, FUN = "/")
km_rel_change_df <- data.frame(cluster = 1:k_chosen, km_rel_change)
write.csv(km_rel_change_df, "kmeans_relative_change.csv", row.names = FALSE)
cat("Saved kmeans_relative_change.csv\n")
cat("\nDone! All output CSVs and the elbow chart have been saved.\n")
library(tidyverse)
setwd("~/UofMaryland/Semester6/BMGT431/431FinalProject")
library(dplyr)
library(ggplot2)
library(caret)
# ------------------------------------------------------------
# 1. LOAD DATA
# ------------------------------------------------------------
house_data <- read.csv("NY-House-Dataset.csv", stringsAsFactors = FALSE)
cat("Original dimensions:", nrow(house_data), "rows,", ncol(house_data), "cols\n")
# ------------------------------------------------------------
# 2. DROP COLUMNS THAT WON'T HELP MODELS
#    Removing address/text fields and redundant location columns
# ------------------------------------------------------------
house_data <- house_data %>%
select(-BROKERTITLE,          # broker name, irrelevant to price
-ADDRESS,              # raw address string
-STREET_NAME,          # too granular
-LONG_NAME,            # property name, not useful
-ADMINISTRATIVE_AREA_LEVEL_2)  # redundant with SUBLOCALITY
# ------------------------------------------------------------
# 3. REMOVE MISSING VALUES
# ------------------------------------------------------------
cat("Missing values before removal:\n")
print(colSums(is.na(house_data)))
house_data <- house_data %>% drop_na()
cat("Rows after removing NAs:", nrow(house_data), "\n")
# ------------------------------------------------------------
# 4. REMOVE DUPLICATES
# ------------------------------------------------------------
house_data <- house_data %>% distinct()
cat("Rows after removing duplicates:", nrow(house_data), "\n")
# ------------------------------------------------------------
# 5. FIX DATA TYPES
#    PRICE, BEDS, BATH, PROPERTYSQFT should all be numeric
# ------------------------------------------------------------
house_data <- house_data %>%
mutate(
PRICE       = as.numeric(PRICE),
BEDS        = as.numeric(BEDS),
BATH        = as.numeric(BATH),
PROPERTYSQFT = as.numeric(PROPERTYSQFT)
)
# Drop any rows that became NA after coercion
house_data <- house_data %>% drop_na()
cat("Rows after type coercion cleanup:", nrow(house_data), "\n")
# ------------------------------------------------------------
# 6. REMOVE PRICE OUTLIERS
#    NYC has extreme luxury listings that will distort models.
#    We remove the bottom 1% (likely data errors) and
#    top 1% (ultra-luxury outliers).
#    We also remove any listings with PRICE <= 0.
# ------------------------------------------------------------
price_low  <- quantile(house_data$PRICE, 0.01)
price_high <- quantile(house_data$PRICE, 0.99)
cat("Price range before outlier removal: $", min(house_data$PRICE),
"to $", max(house_data$PRICE), "\n")
house_data <- house_data %>%
filter(PRICE > 0,
PRICE >= price_low,
PRICE <= price_high)
cat("Price range after outlier removal: $", min(house_data$PRICE),
"to $", max(house_data$PRICE), "\n")
cat("Rows after price outlier removal:", nrow(house_data), "\n")
# ------------------------------------------------------------
# 7. REMOVE PROPERTYSQFT OUTLIERS
#    Same logic — remove bottom and top 1%
#    Also remove any zero or negative sqft values
# ------------------------------------------------------------
sqft_low  <- quantile(house_data$PROPERTYSQFT, 0.01)
sqft_high <- quantile(house_data$PROPERTYSQFT, 0.99)
house_data <- house_data %>%
filter(PROPERTYSQFT > 0,
PROPERTYSQFT >= sqft_low,
PROPERTYSQFT <= sqft_high)
cat("Rows after sqft outlier removal:", nrow(house_data), "\n")
# ------------------------------------------------------------
# 8. FILTER UNREALISTIC BEDS / BATH VALUES
#    Remove listings with 0 beds/baths or extreme counts
# ------------------------------------------------------------
house_data <- house_data %>%
filter(BEDS >= 0,
BATH >= 0,
BEDS <= 20,
BATH <= 20)
cat("Rows after beds/bath filter:", nrow(house_data), "\n")
# ------------------------------------------------------------
# 9. CATEGORICAL VARIABLES
#    TYPE     -> factor (property type: Condo, House, etc.)
#    LOCALITY -> factor (borough-level: Manhattan, Brooklyn, etc.)
#    SUBLOCALITY -> factor (neighborhood level)
# ------------------------------------------------------------
house_data <- house_data %>%
mutate(
TYPE        = as.factor(TYPE),
LOCALITY    = as.factor(LOCALITY),
SUBLOCALITY = as.factor(SUBLOCALITY)
)
cat("\nProperty types in data:\n")
print(table(house_data$TYPE))
cat("\nLocalities (boroughs) in data:\n")
print(table(house_data$LOCALITY))
# ------------------------------------------------------------
# 10. ADD FEATURE: PRICE PER SQFT
#     Useful derived variable for feature importance analysis
# ------------------------------------------------------------
house_data <- house_data %>%
mutate(PRICE_PER_SQFT = PRICE / PROPERTYSQFT)
# ------------------------------------------------------------
# 11. TRAIN / TEST SPLIT (70/30)
#     Set seed for reproducibility
# ------------------------------------------------------------
set.seed(42)
train_index <- createDataPartition(house_data$PRICE, p = 0.70, list = FALSE)
train_data <- house_data[train_index, ]
test_data  <- house_data[-train_index, ]
cat("\nTrain set size:", nrow(train_data), "\n")
cat("Test set size: ", nrow(test_data),  "\n")
# ------------------------------------------------------------
# 12. SUMMARY
# ------------------------------------------------------------
cat("\n--- Final Cleaned Dataset Summary ---\n")
print(summary(house_data[, c("PRICE", "BEDS", "BATH", "PROPERTYSQFT",
"PRICE_PER_SQFT", "LATITUDE", "LONGITUDE")]))
cat("\nPreprocessing complete. Objects ready: house_data, train_data, test_data\n")
# ------------------------------------------------------------
# 13. EXPORT CLEANED DATA TO CSV
# ------------------------------------------------------------
write.csv(house_data, "NY-House-Cleaned.csv", row.names = FALSE)
cat("Cleaned dataset exported to NY-House-Cleaned.csv\n")
